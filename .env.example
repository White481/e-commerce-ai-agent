# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored — never commit real passwords or API keys.

# Warehouse built by https://github.com/White481/e-commerce-data-pipeline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
# The pipeline's admin user: only used by `make agent-role`, and to refuse running the agent as it
POSTGRES_USER=your_user
PG_CONTAINER=ecommerce_postgres

# The agent's own read-only login
AGENT_DB_USER=analyst_ro
AGENT_DB_PASSWORD=change_me
WAREHOUSE_SCHEMA=marts

LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
LLM_TIMEOUT_MS=30000
LLM_THINKING_LEVEL=low

AGENT_MAX_ATTEMPTS=3
AGENT_ROW_LIMIT=200
AGENT_STATEMENT_TIMEOUT_MS=5000
AGENT_QUERY_LOG_PATH=logs/agent_queries.jsonl
